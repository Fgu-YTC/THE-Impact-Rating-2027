rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isUnit(data) {
      return data.keys().hasAll(['name', 'questionIds'])
        && data.keys().hasOnly(['name', 'questionIds', 'group'])
        && data.name is string
        && data.name.size() > 0
        && data.name.size() < 80
        && data.questionIds is list
        && data.questionIds.size() < 400
        && (!('group' in data) || (data.group is string && data.group.size() > 0 && data.group.size() < 40));
    }

    function isAnswer(data) {
      return data.keys().hasOnly([
          'yesNo', 'public', 'comment', 'evidence', 'options', 'values',
          'evidenceFileName', 'evidenceStoredName', 'evidenceFilePath', 'evidenceFileUrl',
          'updatedAt', 'filledBy'
        ])
        && (!('yesNo' in data) || (data.yesNo is string && data.yesNo.size() < 20))
        && (!('public' in data) || (data.public is string && data.public.size() < 20))
        && (!('comment' in data) || (data.comment is string && data.comment.size() <= 1000))
        && (!('evidence' in data) || (data.evidence is string && data.evidence.size() <= 2000))
        && (!('options' in data) || data.options is list)
        && (!('values' in data) || data.values is map)
        && (!('evidenceFileName' in data) || data.evidenceFileName is string)
        && (!('evidenceStoredName' in data) || data.evidenceStoredName is string)
        && (!('evidenceFilePath' in data) || data.evidenceFilePath is string)
        && (!('evidenceFileUrl' in data) || data.evidenceFileUrl is string)
        && (!('updatedAt' in data) || data.updatedAt is string)
        && (!('filledBy' in data) || (data.filledBy is string && data.filledBy.size() > 0 && data.filledBy.size() <= 40));
    }

    function isOffice(data) {
      return data.keys().hasOnly([
          'yesNo', 'public', 'comment', 'evidence', 'options', 'values',
          'evidenceFileName', 'evidenceStoredName', 'evidenceFilePath', 'evidenceFileUrl',
          'updatedAt', 'editor', 'sourceUnitId', 'sourceUnitName', 'filledBy'
        ])
        && data.editor == '永續辦'
        && data.sourceUnitId is string
        && data.sourceUnitId.size() > 0
        && data.sourceUnitId.size() < 80
        && data.sourceUnitName is string
        && data.sourceUnitName.size() < 80
        && (!('yesNo' in data) || (data.yesNo is string && data.yesNo.size() < 20))
        && (!('public' in data) || (data.public is string && data.public.size() < 20))
        && (!('comment' in data) || (data.comment is string && data.comment.size() <= 1000))
        && (!('evidence' in data) || (data.evidence is string && data.evidence.size() <= 2000))
        && (!('options' in data) || data.options is list)
        && (!('values' in data) || data.values is map)
        && (!('evidenceFileName' in data) || data.evidenceFileName is string)
        && (!('evidenceStoredName' in data) || data.evidenceStoredName is string)
        && (!('evidenceFilePath' in data) || data.evidenceFilePath is string)
        && (!('evidenceFileUrl' in data) || data.evidenceFileUrl is string)
        && (!('updatedAt' in data) || data.updatedAt is string)
        && (!('filledBy' in data) || (data.filledBy is string && data.filledBy.size() > 0 && data.filledBy.size() <= 40));
    }

    match /units/{unitId} {
      allow read: if true;
      allow create, update: if isUnit(request.resource.data);
      allow delete: if request.auth != null;

      match /answers/{questionId} {
        allow read: if true;
        allow create, update: if isAnswer(request.resource.data);
        allow delete: if request.auth != null;
      }

      match /office/{questionId} {
        allow read: if true;
        allow create, update: if isOffice(request.resource.data);
        allow delete: if request.auth != null;
      }

      // 單位退回：表示無法回答此題，並可寫退回建議（無建議填「無」）
      match /returns/{questionId} {
        allow read: if true;
        allow create, update: if request.resource.data.keys().hasOnly(['suggestion', 'updatedAt', 'filledBy'])
          && request.resource.data.suggestion is string
          && request.resource.data.suggestion.size() > 0
          && request.resource.data.suggestion.size() <= 500
          && request.resource.data.updatedAt is string
          && (!('filledBy' in request.resource.data) || (request.resource.data.filledBy is string && request.resource.data.filledBy.size() > 0 && request.resource.data.filledBy.size() <= 40));
        allow delete: if true;
      }
    }

    match /{path=**}/answers/{questionId} {
      allow read: if true;
    }

    match /{path=**}/returns/{questionId} {
      allow read: if true;
    }

    // 單位分組名稱（院／行政單位等）
    match /meta/{docId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }
  }
}
